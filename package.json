{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@hometruth/tkenpro",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "types": "./src/protocols/tkenpro/index.ts",
  "bin": {
    "ht": "./src/ht/index.ts",
    "tkenpro": "./src/vendors/tkenpro/cli.ts"
  },
  "exports": {
    ".": "./src/protocols/tkenpro/index.ts",
    "./client": "./src/client/index.ts",
    "./cli": "./src/vendors/tkenpro/cli.ts",
    "./discovery": "./src/protocols/tkenpro/discovery.ts",
    "./onvif": "./src/protocols/onvif/client.ts",
    "./server": "./src/server/app.ts"
  },
  "engines": {
    "bun": ">=1.3.12"
  },
  "scripts": {
    "ht": "bun scripts/site.ts ../hometruth_private ht",
    "skills:install": "bun skills/install.ts",
    "camera": "bun scripts/site.ts ../hometruth_private camera",
    "dev": "bun scripts/site.ts ../hometruth_private dev",
    "start": "bun scripts/site.ts ../hometruth_private start",
    "matter:status": "bun scripts/site.ts ../hometruth_private matter:status",
    "matter:pair": "bun scripts/site.ts ../hometruth_private matter:pair",
    "hue:proxy": "bun scripts/site.ts ../hometruth_private hue:proxy",
    "hue:proxy:build": "bun scripts/site.ts ../hometruth_private hue:proxy:build",
    "hue:proxy:test": "bun test src/integrations/hue-proxy",
    "typecheck": "bunx --bun tsc --noEmit",
    "schemas:build": "bun scripts/schema-hosting/build.ts",
    "schemas:test": "bun test scripts/schema-hosting/publication.test.ts src/schema-catalog.test.ts src/object-schemas.test.ts",
    "schemas:deploy": "wrangler deploy --config scripts/schema-hosting/wrangler.jsonc --outdir dist/schema-hosting/deploy",
    "test": "bun test",
    "test:e2e": "playwright test",
    "kindle:install-browser": "playwright install chromium",
    "check": "bun run typecheck && bun test && bun run test:e2e",
    "site": "bun scripts/site.ts",
    "release:prepare": "python3 scripts/release.py prepare",
    "release:check": "python3 scripts/release.py check",
    "test:release": "bun test scripts/site.test.ts src/runtime/paths.test.ts && python3 -m unittest discover -s scripts -p \"test_release.py\"",
    "hooks:install": "git config core.hooksPath .githooks",
    "network": "bun scripts/site.ts ../hometruth_private network",
    "hue:discover": "bun scripts/site.ts ../hometruth_private hue:discover",
    "ring:discover": "bun scripts/site.ts ../hometruth_private ring:discover",
    "reveal": "bun scripts/site.ts ../hometruth_private reveal"
  },
  "dependencies": {
    "@matter/main": "0.17.9",
    "aedes": "^1.1.2",
    "aedes-server-factory": "^0.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "hap-controller": "0.10.2",
    "hono": "4.13.5",
    "mqtt": "^5.15.2",
    "playwright": "1.62.1",
    "qrcode": "1.5.4",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "@types/qrcode": "1.5.6",
    "json-schema-to-ts": "3.1.1",
    "typescript": "7.0.2",
    "wrangler": "4.135.0"
  },
  "license": "MIT"
}
