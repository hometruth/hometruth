# Copy this example to <private-installation>/.env.local if needed.
# All relative runtime paths resolve inside that private directory.
# Camera account, ONVIF login, and UniFi key now live in .hometruth/secrets.yml (see docs/REPOSITORIES.md).
# The server imports the variables below once, on its first start without that file, then ignores them.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
DEV_HUB=on

# Vendor cloud login requires app signing credentials supplied separately.
# Local discovery/control does not need them. Keep values in ignored local
# environment files or deployment secret storage, never in a Git repository.
# MEARI_CA_KEY=
# MEARI_CA_SECRET=

# Apple Home's Matter bridge starts with HomeTruth and keeps pairing in .hometruth/matter.
# HOMETRUTH_MATTER_ENABLED=0       # disable Apple Home export
# HOMETRUTH_NODE_BINARY=/absolute/path/to/node
# HOMETRUTH_MATTER_PORT=5540
# HOMETRUTH_MATTER_POLL_MS=2000
# HOMETRUTH_MATTER_STORAGE=.hometruth/matter

# Site defaults for the web UI; each browser can override them from the page footer.
# HOMETRUTH_THEME=euclid        # euclid | swiss | brutal
# HOMETRUTH_SCHEME=auto         # auto | light | dark
# HOMETRUTH_LOCALE=en           # en | de | fr | es (otherwise Accept-Language)

# Optional fallback for the web interface and CLI. HomeTruth never writes this
# file: settings saved in the web interface go to .hometruth/camera-setup.json.
# Per-camera addresses belong in devices.yml, not here.
# The CLI never accepts password flags.
TKENPRO_CAMERA_HOST=
ONVIF_USERNAME=admin
ONVIF_PASSWORD=
TKENPRO_PROFILE=tkenpro
TKENPRO_EMAIL=
TKENPRO_PASSWORD=
TKENPRO_COUNTRY=US
TKENPRO_PHONE_CODE=
TKENPRO_SERIAL=

# Optional Network Tools provider. See docs/NETWORK_TOOLS.md.
# Store UniFi credentials with: bun run ht secrets set network.unifi.apiKey
# HOMETRUTH_NETWORK_ADAPTER=command
# HOMETRUTH_NETWORK_COMMAND='["python3","/absolute/path/to/my-router.py"]'
# HOMETRUTH_NETWORK_CAPABILITIES=addresses,wifi,dns,internet
# HOMETRUTH_NETWORK_TARGET=my-router/site-a
# HOMETRUTH_NETWORK_COMMAND_TIMEOUT_MS=30000
