{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hometruth-schemas",
  "main": "../../dist/schema-hosting/worker.js",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "hometruth.ai", "custom_domain": true }],
  "build": { "command": "bun run schemas:build" },
  "no_bundle": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    "preview": {
      "name": "hometruth-schemas-preview",
      "workers_dev": true,
      "preview_urls": false,
      "routes": []
    }
  }
}
